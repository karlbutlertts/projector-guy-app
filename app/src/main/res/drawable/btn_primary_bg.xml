<?xml version="1.0" encoding="utf-8"?>
<!-- Plain solid pill by default; a visible white ring when D-pad-focused
     (mirrors the focus-ring convention used throughout the web app) so a
     remote user gets clear confirmation the button is selected before
     pressing OK. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/btn_primary_bg_focused" />
    <item android:drawable="@drawable/btn_primary_bg_plain" />
</selector>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- USB host so the projector exposes plugged-in drives -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Visibility into hidden factory/engineering menu packages (Android 11+) -->
    <queries>
        <package android:name="com.sstar.factorymenu" />
        <package android:name="com.sstar.systemcontrol" />
        <package android:name="com.sstar.customizedmenu" />
        <package android:name="com.newlink.projector.service" />
        <package android:name="com.newlink.factorymenu" />
        <package android:name="com.newlink.service" />
        <package android:name="com.zhiying.settings" />
        <package android:name="com.android.tv.settings" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ProjectorGuy">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:screenOrientation="landscape"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ProjectorGuy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
